# Backend Environment Variables - Loopia Hosting
PORT=3001
NODE_ENV=production

# MariaDB Database Configuration (Loopia)
DB_HOST=your_database_server_here
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_username
DB_PASSWORD=your_database_password

# JWT Secret (change this!)
JWT_SECRET=change_this_to_random_secret_key

# CORS
CORS_ORIGIN=https://radio.infinityplay.rs
